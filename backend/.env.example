# Copie para .env e ajuste se precisar.
# Exemplo de banco hospedado no Neon (pegue a string no painel do Neon, em Connect):
WUA_DB_URL=postgresql://USUARIO:SENHA@HOST.neon.tech/NOME_DO_BANCO?sslmode=require

# Segredo de assinatura do JWT (ADR-004, minimo 32 caracteres para HS256).
# Gere um com: openssl rand -hex 32
WUA_SEGREDO=troque-este-segredo-em-producao-minimo-32-bytes

# Validade do token de sessao em horas (ADR-004).
WUA_TOKEN_VALIDADE_HORAS=8

# Porta do servidor de desenvolvimento (diferente da API do BI, que usa 8000).
WUA_PORTA=8001