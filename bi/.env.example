# Copie para .env e ajuste se precisar.
WUA_DB_URL=postgresql://wua:wua_dev@localhost:55432/wua

# Caminho do catalogo de fases (ADR-006). Por padrao, a raiz do repositorio.
WUA_CATALOGO=../catalogo-fases.json

# Segredo do token provisorio da API. Em producao vem do back-end (ADR-004).
WUA_SEGREDO=troque-este-segredo-em-producao

# Minutos entre execucoes no modo `etl agendar` (ADR-009).
WUA_ETL_INTERVALO_MIN=15

# Para onde vai o aviso quando uma execucao do ETL falha. Vazio = so stderr e
# a coluna erro de bronze.etl_execucao. Aceita qualquer URL que receba POST
# com JSON (Discord, Slack, Teams, um script proprio).
WUA_ALERTA_WEBHOOK=
