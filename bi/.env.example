# Copie para .env e ajuste se precisar.
WUA_DB_URL=postgresql://wua:wua_dev@localhost:55432/wua

# Caminho do catalogo de fases (ADR-006). Por padrao, a raiz do repositorio.
WUA_CATALOGO=../catalogo-fases.json

# Segredo compartilhado com o back-end para validacao do JWT (ADR-004, minimo
# 32 bytes).
#
# TEM DE SER O MESMO VALOR do WUA_SEGREDO em backend/.env. Quem assina o token
# e o back-end; aqui so conferimos a assinatura (ADR-002). Com valores
# diferentes o login funciona e todo pedido seguinte responde 401 dizendo que
# a assinatura do token nao confere (issue #17).
#
# Gere um com: openssl rand -hex 32
WUA_SEGREDO=troque-este-segredo-em-producao-minimo-32-bytes

# URL do servico de back-end para delegacao do login (ADR-002, ADR-004).
WUA_BACKEND_URL=http://localhost:8001

# Minutos entre execucoes no modo `etl agendar` (ADR-009).
WUA_ETL_INTERVALO_MIN=15

# Para onde vai o aviso quando uma execucao do ETL falha. Vazio = so stderr e
# a coluna erro de bronze.etl_execucao. Aceita qualquer URL que receba POST
# com JSON (Discord, Slack, Teams, um script proprio).
WUA_ALERTA_WEBHOOK=
