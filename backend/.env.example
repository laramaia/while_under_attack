# Copie para .env e ajuste se precisar.
WUA_DB_URL=postgresql://wua:wua_dev@localhost:55432/wua

# Segredo de assinatura do JWT (ADR-004, minimo 32 caracteres para HS256).
#
# TEM DE SER O MESMO VALOR do WUA_SEGREDO em bi/.env. Quem assina o token e
# este servico; quem confere a assinatura e a API do BI (ADR-002). Com valores
# diferentes o login funciona -- a senha e conferida aqui -- e todo pedido
# seguinte ao dashboard responde 401 dizendo que a assinatura do token nao
# confere (issue #17). Ao trocar este valor, troque o do bi/.env junto.
WUA_SEGREDO=troque-este-segredo-em-producao-minimo-32-bytes

# Validade do token de sessao em horas (ADR-004).
WUA_TOKEN_VALIDADE_HORAS=8

# Porta do servidor de desenvolvimento (diferente da API do BI, que usa 8000).
WUA_PORTA=8001
